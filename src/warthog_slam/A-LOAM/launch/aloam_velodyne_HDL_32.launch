<launch>
    <arg name="cloud_topic" default="/rslidar_points_static_moving" />
    <arg name="rviz" default="true" />
    <arg name="mapping_skip_frame" default="1" />

    <param name="scan_line" type="int" value="32" />

    <!-- Number of odometry frames between mapping inputs. -->
    <param name="mapping_skip_frame" type="int" value="$(arg mapping_skip_frame)" />

    <!-- remove too closed points -->
    <param name="minimum_range" type="double" value="0.3"/>
    <!-- Keep only a fixed horizontal sector to avoid Warthog chassis returns.
         0 deg = forward (+X), positive angles = left (+Y). -->
    <param name="horizontal_angle_filter_enabled" type="bool" value="true"/>
    <!-- <param name="horizontal_angle_min_deg" type="double" value="-120.0"/>
    <param name="horizontal_angle_max_deg" type="double" value="120.0"/> -->

    

    <param name="mapping_line_resolution" type="double" value="0.2"/>
    <param name="mapping_plane_resolution" type="double" value="0.4"/>

    <node pkg="aloam_velodyne" type="ascanRegistration" name="ascanRegistration" output="screen">
        <!-- This fork subscribes to /rslidar_points directly in scanRegistration.cpp;
             remap it to the static cloud published by moving_dynamic_filter_node. -->
        <remap from="/rslidar_points" to="$(arg cloud_topic)" />
    </node>


    <node pkg="aloam_velodyne" type="alaserOdometry" name="alaserOdometry" output="screen" />

    <node pkg="aloam_velodyne" type="alaserMapping" name="alaserMapping" output="screen" />
    

    <group if="$(arg rviz)">
        <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find aloam_velodyne)/rviz_cfg/aloam_velodyne.rviz" />
    </group>

</launch>

<!-- Đây là file chạy với dữ liệu lidar thuần -->

