<launch>
    <arg name="run_lidar" default="true" />
    <arg name="cloud_topic" default="/rslidar_points" />
    <arg name="rviz" default="true" />

    <include if="$(arg run_lidar)" file="$(find rslidar_sdk)/launch/start.launch" />

    <include file="$(find aloam_velodyne)/launch/aloam_velodyne_HDL_32.launch">
        <arg name="cloud_topic" value="$(arg cloud_topic)" />
        <arg name="rviz" value="$(arg rviz)" />
    </include>
</launch>


