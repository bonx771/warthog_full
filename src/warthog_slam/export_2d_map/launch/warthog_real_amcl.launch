<launch>

    <!-- RViz -->
    <arg name="rviz" default="true"/>
    <arg name="config" default="default" />

    <!-- Không dùng thời gian mô phỏng khi chạy xe thật -->
    <param name="/use_sim_time" value="false"/>

    <!-- ========================= -->
    <!-- Các topic thật trên xe -->
    <!-- ========================= -->

    <!-- Topic point cloud từ Helios32 -->
    <arg name="cloud_topic" default="/rslidar_points"/>

    <!-- Topic LaserScan sau khi convert -->
    <arg name="scan_topic" default="/scan"/>

    <!--
      Mặc định dùng RF2O để tự tạo odom từ /scan.
      Nếu muốn dùng odom bánh xe / EKF thật của xe thì set:
      use_rf2o_odom:=false wheel_odom_topic:=/warthog_velocity_controller/odom
    -->
    <arg name="use_rf2o_odom" default="true"/>
    <arg name="wheel_odom_topic" default="/warthog_velocity_controller/odom"/>
    <arg name="rf2o_odom_topic" default="/odom_rf2o"/>
    <arg name="nav_odom_topic" default="$(eval arg('rf2o_odom_topic') if arg('use_rf2o_odom') == 'true' else arg('wheel_odom_topic'))"/>

    <!-- Frame của LiDAR, phải kiểm tra bằng:
        rostopic echo -n1 /rslidar_points/header
    -->
    <arg name="lidar_frame" default="rslidar"/>

    <!-- Frame robot -->
    <arg name="base_frame" default="base_link"/>

    <!-- Map đã tạo sẵn -->
    <arg name="map_file" default="$(find warthog_slam)/maps/aloam_map.yaml"/>

    <!-- ========================= -->
    <!-- Static TF: base_link -> LiDAR -->
    <!-- Sửa x y z roll pitch yaw theo vị trí lắp thật của Helios32 -->
    <!-- Ví dụ: LiDAR đặt trước 0.6m, cao 1.1m -->
    <!-- ========================= -->
    <node pkg="tf" type="static_transform_publisher"
            name="base_to_helios32"
            args="0.40 0.0 1.10 0 0 0 $(arg base_frame) $(arg lidar_frame) 100"/>


    <!-- ========================= -->
    <!-- Map server -->
    <!-- ========================= -->
    <node name="map_server"
            pkg="map_server"
            type="map_server"
            args="$(arg map_file)"
            output="screen"/>

    <!-- Tự tạo odom -> base_link từ /scan khi không có odom thật -->
    <include if="$(arg use_rf2o_odom)" file="$(find rf2o_laser_odometry)/launch/rf2o_laser_odometry.launch">
        <arg name="laser_scan_topic" value="$(arg scan_topic)"/>
        <arg name="odom_topic" value="$(arg rf2o_odom_topic)"/>
        <arg name="publish_tf" value="true"/>
        <arg name="odom_frame_id" value="odom"/>
        <arg name="base_frame_id" value="$(arg base_frame)"/>
        <arg name="freq" value="15.0"/>
        <arg name="verbose" value="false"/>
    </include>

    <!-- Dùng odom thật của xe nếu có -->
    <node unless="$(arg use_rf2o_odom)"
            pkg="export_2d_map"
            type="odom_to_tf.py"
            name="odom_to_tf"
            output="screen">
        <param name="odom_topic" value="$(arg wheel_odom_topic)"/>
        <param name="parent_frame" value="odom"/>
        <param name="child_frame" value="$(arg base_frame)"/>
    </node>

    <!-- ========================= -->
    <!-- AMCL -->
    <!-- ========================= -->
    <node pkg="amcl" type="amcl" name="amcl" output="screen">

        <param name="use_map_topic" value="true"/>

        <param name="global_frame_id" value="map"/>
        <param name="odom_frame_id" value="odom"/>
        <param name="base_frame_id" value="$(arg base_frame)"/>

        <param name="min_particles" value="500"/>
        <param name="max_particles" value="3000"/>
        <param name="kld_err" value="0.02"/>

        <param name="update_min_d" value="0.20"/>
        <param name="update_min_a" value="0.20"/>
        <param name="resample_interval" value="1"/>
        <param name="transform_tolerance" value="1.0"/>

        <param name="recovery_alpha_slow" value="0.001"/>
        <param name="recovery_alpha_fast" value="0.1"/>

        <!-- Với Helios32 ngoài trời, nên tăng range so với 3.5m cũ -->
        <param name="laser_max_range" value="30.0"/>
        <param name="laser_max_beams" value="360"/>

        <param name="laser_z_hit" value="0.5"/>
        <param name="laser_z_short" value="0.05"/>
        <param name="laser_z_max" value="0.05"/>
        <param name="laser_z_rand" value="0.5"/>
        <param name="laser_sigma_hit" value="0.2"/>
        <param name="laser_lambda_short" value="0.1"/>
        <param name="laser_likelihood_max_dist" value="2.0"/>
        <param name="laser_model_type" value="likelihood_field"/>

        <!-- Warthog là xe skid-steer / differential-like -->
        <param name="odom_model_type" value="diff"/>
        <param name="odom_alpha1" value="0.1"/>
        <param name="odom_alpha2" value="0.1"/>
        <param name="odom_alpha3" value="0.1"/>
        <param name="odom_alpha4" value="0.1"/>

        <remap from="scan" to="$(arg scan_topic)"/>

    </node>

    <!-- ========================= -->
    <!-- Move base -->
    <!-- ========================= -->
    <include file="$(find warthog_slam)/launch/move_base.launch">
        <arg name="dwa_planner" value="true"/>
        <arg name="odom_topic" value="$(arg nav_odom_topic)"/>
        <arg name="scan_topic" value="$(arg scan_topic)"/>
        <arg name="laser_frame" value="$(arg lidar_frame)"/>
    </include>

    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="$(anon rviz)" respawn="false" 
        output="screen" args="-d $(find warthog_simulation)/rviz/$(arg config).rviz" />

</launch>
