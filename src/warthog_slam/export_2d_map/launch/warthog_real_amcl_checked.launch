<launch>

  <arg name="rviz" default="true"/>
  <arg name="use_sim_time" default="false"/>

  <arg name="cloud_topic" default="/rslidar_points"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="use_scan_converter" default="true"/>

  <arg name="use_rf2o_odom" default="false"/>
  <arg name="wheel_odom_topic" default="/odometry/filtered"/>
  <arg name="rf2o_odom_topic" default="/odom_rf2o"/>
  <arg name="nav_odom_topic" default="$(eval arg('rf2o_odom_topic') if arg('use_rf2o_odom') == 'true' else arg('wheel_odom_topic'))"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>

  <arg name="map_frame" default="map"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="lidar_frame" default="rslidar"/>

  <arg name="publish_lidar_static_tf" default="false"/>
  <arg name="publish_wheel_odom_tf" default="false"/>

  <arg name="lidar_x" default="0.40"/>
  <arg name="lidar_y" default="0.0"/>
  <arg name="lidar_z" default="1.10"/>
  <arg name="lidar_roll" default="0.0"/>
  <arg name="lidar_pitch" default="0.0"/>
  <arg name="lidar_yaw" default="0.0"/>

  <arg name="map_file" default="$(find warthog_slam)/maps/aloam_map_1.yaml"/>
  <arg name="dwa_planner" default="true"/>

  <arg name="initial_pose_x" default="0.0"/>
  <arg name="initial_pose_y" default="0.0"/>
  <arg name="initial_pose_a" default="0.0"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <include if="$(arg use_scan_converter)" file="$(find export_2d_map)/launch/helios32_to_scan.launch">
    <arg name="cloud_topic" value="$(arg cloud_topic)"/>
    <arg name="scan_topic" value="$(arg scan_topic)"/>
    <arg name="lidar_frame" value="$(arg lidar_frame)"/>
  </include>

  <node if="$(arg publish_lidar_static_tf)"
        pkg="tf"
        type="static_transform_publisher"
        name="base_to_lidar"
        args="$(arg lidar_x) $(arg lidar_y) $(arg lidar_z) $(arg lidar_roll) $(arg lidar_pitch) $(arg lidar_yaw) $(arg base_frame) $(arg lidar_frame) 100"/>

  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" output="screen"/>

  <node if="$(arg use_rf2o_odom)"
        pkg="rf2o_laser_odometry"
        type="rf2o_laser_odometry_node"
        name="laser_odometry"
        output="screen">
    <param name="laser_scan_topic" value="$(arg scan_topic)"/>
    <param name="odom_topic" value="$(arg rf2o_odom_topic)" />
    <param name="publish_tf" value="true" />
    <param name="base_frame_id" value="$(arg base_frame)"/>
    <param name="odom_frame_id" value="$(arg odom_frame)" />
    <param name="init_pose_from_topic" value="" />
    <param name="freq" value="15.0"/>
    <param name="verbose" value="false" />
  </node>

  <node if="$(eval arg('use_rf2o_odom') == 'false' and arg('publish_wheel_odom_tf') == 'true')"
        pkg="export_2d_map"
        type="odom_to_tf.py"
        name="odom_to_tf"
        output="screen">
    <param name="odom_topic" value="$(arg wheel_odom_topic)"/>
    <param name="parent_frame" value="$(arg odom_frame)"/>
    <param name="child_frame" value="$(arg base_frame)"/>
  </node>

  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="use_map_topic" value="true"/>

    <param name="global_frame_id" value="$(arg map_frame)"/>
    <param name="odom_frame_id" value="$(arg odom_frame)"/>
    <param name="base_frame_id" value="$(arg base_frame)"/>

    <param name="min_particles" value="500"/>
    <param name="max_particles" value="3000"/>
    <param name="kld_err" value="0.02"/>
    <param name="update_min_d" value="0.20"/>
    <param name="update_min_a" value="0.20"/>
    <param name="resample_interval" value="1"/>
    <param name="transform_tolerance" value="1.0"/>
    <param name="recovery_alpha_slow" value="0.001"/>
    <param name="recovery_alpha_fast" value="0.1"/>
    <param name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <param name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <param name="initial_pose_a" value="$(arg initial_pose_a)"/>
    <param name="gui_publish_rate" value="10.0"/>

    <remap from="scan" to="$(arg scan_topic)"/>
    <param name="laser_max_range" value="30.0"/>
    <param name="laser_max_beams" value="360"/>
    <param name="laser_z_hit" value="0.5"/>
    <param name="laser_z_short" value="0.05"/>
    <param name="laser_z_max" value="0.05"/>
    <param name="laser_z_rand" value="0.5"/>
    <param name="laser_sigma_hit" value="0.2"/>
    <param name="laser_lambda_short" value="0.1"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>
    <param name="laser_model_type" value="likelihood_field"/>

    <param name="odom_model_type" value="diff"/>
    <param name="odom_alpha1" value="0.1"/>
    <param name="odom_alpha2" value="0.1"/>
    <param name="odom_alpha3" value="0.1"/>
    <param name="odom_alpha4" value="0.1"/>
  </node>

  <include file="$(find export_2d_map)/launch/move_base_real.launch">
    <arg name="dwa_planner" value="$(arg dwa_planner)"/>
    <arg name="odom_topic" value="$(arg nav_odom_topic)"/>
    <arg name="scan_topic" value="$(arg scan_topic)"/>
    <arg name="laser_frame" value="$(arg lidar_frame)"/>
    <arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
  </include>

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find aloam_velodyne)/rviz_cfg/real.rviz" />
  </group>

</launch>



<!-- roslaunch export_2d_map warthog_real_amcl_checked.launch -->
